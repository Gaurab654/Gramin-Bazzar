@model ShoppingCartViewModel

@{
    ViewData["Title"] = "Shopping Cart";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />

<div class="container my-5">
    <div class="card shadow-lg rounded-4 border-0">
        <div class="card-header bg-success text-white text-center py-3 rounded-top-4">
            <h2 class="mb-0">🛒 Shopping Cart</h2>
        </div>

        <div class="card-body p-4" style="max-height: 600px; overflow-y: auto;">
            @if (Model.CartItems != null && Model.CartItems.Any())
            {
                <div class="row g-4">
                    @foreach (var item in Model.CartItems)
                    {
                        <div class="col-md-6 col-lg-4">
                            <div class="card border-0 shadow-sm h-100 rounded-4">
                                <div class="card-body">
                                    <h5 class="card-title text-success fw-bold">@item.Product?.ProductName</h5>
                                    
                                    <p class="mb-1">
                                        <strong>👤 Seller:</strong> @item.Product?.SellerName
                                    </p>
                                    <p class="mb-1">
                                        <strong>📧 Email:</strong> @item.Product?.Email
                                    </p>
                                    <p class="mb-1">
                                        <strong>📞 Phone:</strong> @item.Product?.PhoneNumber
                                    </p>
                                    

                                    <hr />
                                    <p class="mb-1"><strong>💰 Price:</strong> Rs. @item.Product?.Price</p>
                                    <p class="mb-1"><strong>📦 Quantity:</strong> @item.Quantity</p>
                                    <p class="mb-1"><strong>📊 Stock:</strong> @item.Product?.StockQuantity</p>
                                    <p class="fw-bold text-success mt-2">
                                        🧮 Subtotal: Rs. @(item.Product?.Price * item.Quantity ?? 0)
                                    </p>
                                </div>
                                <div class="card-footer bg-transparent text-center border-0 pb-3">
                                    <form asp-action="RemoveItem" asp-route-id="@item.Product.ProductId" method="post">
                                        <button type="submit" class="btn btn-danger btn-sm w-75">🗑️ Remove</button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    }
                </div>

                <hr class="my-4" />

                <div class="d-flex justify-content-between align-items-center">
                    <h4 class="fw-bold text-success mb-0">
                        🧾 Total: Rs. @Model.TotalPrice
                    </h4>
                    <div>
                        <a href="/ProductGM/List" class="btn btn-outline-success me-2">
                            🛍️ Continue Shopping
                        </a>
                        <a href="/Checkout" class="btn btn-success">
                            ✅ Checkout
                        </a>
                    </div>
                </div>
            }
            else
            {
                <div class="alert alert-warning text-center" role="alert">
                    🛒 Your cart is empty. <a href="/Products/Index" class="alert-link">Start shopping</a>
                </div>
            }
        </div>
    </div>
</div>
