@model IEnumerable<Gramin_Bazzar_marketplace_for_rural_Nepal_.Models.Product>

@{
    ViewData["Title"] = "Product List";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />

@if (TempData["Message"] != null)
{
    <div class="alert alert-warning alert-dismissible fade show" role="alert">
        <strong>Alert Message!!!</strong> @TempData["Message"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<h2 class="text-center mb-4">Available Products</h2>

<div class="container mt-5">
    <h2 class="text-center mb-5 text-primary">Explore Local Products</h2>

    <div class="row g-5">
        @foreach (var item in Model)
        {
            <div class="col-12">
                <div class="card shadow-lg p-4 mb-4">
                    <div class="row g-4">
                        <div class="col-md-6">
                            <img src="~/ProductPhoto/@Html.DisplayFor(modelItem=>item.ImageName)"
                                 class="img-fluid rounded w-100"
                                 style="max-height: 100%; object-fit: contain;"
                                 alt="Product Image" />
                        </div>

                        <div class="col-md-6 d-flex flex-column justify-content-between">
                            <div>
                                <h4 class="text-success fw-bold">@item.ProductName</h4>
                                <p class="text-muted">@item.Description</p>
                                <p><strong>Price:</strong> Rs. @item.Price</p>
                                <p><strong>Stock:</strong> @item.StockQuantity Kg/piece</p>
                                <p><strong>Category:</strong> @item.Category?.CategoryType</p>
                                <p><strong>Seller:</strong> @item.SellerName</p>
                                <p><strong>Location:</strong> @item.District?.DistrictName, @item.State?.StateName</p>
                            </div>

                            <div class="mb-3">
                                <a class="btn btn-primary btn-sm mb-1 w-100" asp-controller="ShoppingCart" asp-action="AddToCart" asp-route-id="@item.ProductId">Add to Cart</a>
                                <a class="btn btn-danger btn-sm w-100 mb-1" asp-controller="EditDelete" asp-action="Delete" asp-route-id="@item.ProductId">Delete</a>
                            </div>

                            @* Recommended Products *@
                            <div>
                                <h6 class="text-secondary">Recommended for you:</h6>
                                <div class="row">
                                    @{
                                        var recommendedProducts = ViewBag.Recommendations[item.ProductId] as List<Gramin_Bazzar_marketplace_for_rural_Nepal_.Models.Product>;
                                        if (recommendedProducts != null)
                                        {
                                            foreach (var rec in recommendedProducts)
                                            {
                                                <div class="col-4 mb-2">
                                                    <div class="card p-2">
                                                        <img src="~/ProductPhoto/@rec.ImageName" class="img-fluid rounded w-100" style="height:80px; object-fit:cover;" />
                                                        <p class="mb-0 text-center small">@rec.ProductName</p>
                                                        <a class="btn btn-primary btn-sm mb-1 w-100" asp-controller="ShoppingCart" asp-action="AddToCart" asp-route-id="@item.ProductId">Add to Cart</a>
                                                    </div>
                                                </div>
                                            }
                                        }
                                    }
                                </div>
                            </div>

                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
