@{
    ViewData["Title"] = "Contact Us";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />

<style>
    body {
        background-color: #f5f9f6;
    }

    .contact-header {
        background: linear-gradient(120deg, #4CAF50, #8BC34A);
        color: white;
        padding: 60px 0;
        text-align: center;
        border-radius: 0 0 40px 40px;
    }

        .contact-header h1 {
            font-weight: 700;
            font-size: 2.8rem;
        }

        .contact-header p {
            font-size: 1.2rem;
            opacity: 0.9;
        }

    .contact-info {
        background: white;
        border-radius: 25px;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
        padding: 40px;
        margin-top: 60px;
        transition: all 0.3s ease;
    }

        .contact-info:hover {
            transform: translateY(-5px);
        }

    .info-box {
        background-color: #e8f5e9;
        border-radius: 15px;
        padding: 20px;
        margin-bottom: 15px;
    }

        .info-box i {
            font-size: 1.7rem;
            color: #4CAF50;
            margin-right: 15px;
        }

    iframe {
        border-radius: 25px;
        width: 100%;
        height: 320px;
        border: none;
    }
</style>

<div class="contact-header">
    <h1>Contact Us</h1>
    <p>We’re here to help — reach out to us for any inquiries or support.</p>
</div>

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="contact-info">
                <div class="info-box d-flex align-items-center">
                    <i class="bi bi-geo-alt-fill"></i>
                    <div>
                        <h6 class="fw-bold mb-1">Our Location</h6>
                        <p class="mb-0">Kathmandu, Nepal</p>
                    </div>
                </div>
                <div class="info-box d-flex align-items-center">
                    <i class="bi bi-telephone-fill"></i>
                    <div>
                        <h6 class="fw-bold mb-1">Call Us</h6>
                        <p class="mb-0">+977-9800000000</p>
                    </div>
                </div>
                <div class="info-box d-flex align-items-center">
                    <i class="bi bi-envelope-fill"></i>
                    <div>
                        <h6 class="fw-bold mb-1">Email</h6>
                        <p class="mb-0">support@graminbazzar.com</p>
                    </div>
                </div>
                <div class="info-box d-flex align-items-center">
                    <i class="bi bi-clock-fill"></i>
                    <div>
                        <h6 class="fw-bold mb-1">Working Hours</h6>
                        <p class="mb-0">Sunday – Friday: 9:00 AM – 6:00 PM</p>
                    </div>
                </div>

                <div class="mt-4">
                    <iframe src="https://www.google.com/maps?q=Kathmandu%20Nepal&output=embed">
                    </iframe>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.js"></script>
