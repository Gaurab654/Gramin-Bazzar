@model Microsoft.AspNetCore.Identity.IdentityRole

@{
    ViewData["Title"] = "Create Role";
}

<div class="container mt-4">
    <div class="card shadow rounded-4">
        <div class="card-header bg-success text-white">
            <h4 class="mb-0">Create New Role</h4>
        </div>
        <div class="card-body">
            <form asp-action="Create" method="post">
                <div class="form-group mb-3">
                    <label asp-for="Name" class="form-label">Role Name</label>
                    <input asp-for="Name" class="form-control" placeholder="Enter role name (e.g., Seller, Buyer)" required />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>

                <button type="submit" class="btn btn-success">Create Role</button>
                <a asp-action="Index" class="btn btn-secondary">Cancel</a>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
